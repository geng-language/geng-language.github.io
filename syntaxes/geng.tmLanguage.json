{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "geng",
  "scopeName": "source.geng",
  "fileTypes": [
    "geng"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.geng",
          "match": "--.*$"
        },
        {
          "name": "comment.block.geng",
          "begin": "\\{-",
          "end": "-\\}"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.geng",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.geng",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.geng",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.geng",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.geng",
          "match": "'(\\\\.|[^'])'"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.geng",
      "match": "\\b(0x[0-9A-Fa-f]+|[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?)\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.geng",
          "match": "\\b(if|then|else|when|is|let|in)\\b"
        },
        {
          "name": "keyword.other.geng",
          "match": "\\b(module|exposing|import|as|type|alias|class|instance|where)\\b"
        },
        {
          "name": "storage.modifier.attribute.geng",
          "match": "@[a-zA-Z]+"
        },
        {
          "name": "keyword.operator.geng",
          "match": "(\\|>|<\\||>>|<<|\\+\\+|==|/=|<=|>=|&&|\\|\\||//|->|[+\\-*/^<>=|\\\\])"
        }
      ]
    },
    "constants": {
      "name": "constant.language.geng",
      "match": "\\b(True|False)\\b"
    },
    "types": {
      "name": "entity.name.type.geng",
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
    }
  }
}
