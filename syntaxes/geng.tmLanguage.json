{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "geng",
  "scopeName": "source.geng",
  "fileTypes": ["geng"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#function-calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.geng", "match": "//.*$" },
        { "name": "comment.block.geng", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.geng",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.geng", "match": "\\\\." }
      ]
    },
    "numbers": {
      "name": "constant.numeric.geng",
      "match": "\\b(0x[0-9A-Fa-f_]+|0b[01_]+|[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?)\\b"
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.geng", "match": "\\b(if|else|while|for|in|return|break|continue|match)\\b" },
        { "name": "keyword.other.geng", "match": "\\b(fn|let|var|const|type|struct|enum|import|pub)\\b" }
      ]
    },
    "constants": {
      "name": "constant.language.geng",
      "match": "\\b(true|false|nil)\\b"
    },
    "function-calls": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.geng" } }
    }
  }
}
